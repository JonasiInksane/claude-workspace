# Environment variable NAMES used by this workspace. Never put values in this file.
# Set real values as user environment variables, then open a new terminal, e.g. in PowerShell:
#   [Environment]::SetEnvironmentVariable('GITHUB_TOKEN', '<value>', 'User')
# MCP servers read ${VAR} from the environment Claude Code starts in. Nothing in this
# workspace loads a .env file for you (.env files are gitignored either way).
# See knowledge/claude-code/mcp-servers.md before adding an MCP server.

# Optional: GitHub personal access token, only needed if you add a GitHub MCP server.
GITHUB_TOKEN=
