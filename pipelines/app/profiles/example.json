{
  "version": 1,
  "project": "example",
  "label": "Example",
  "_note": "Synthetic. Describes a made-up project with an api and a web workspace; tests build repos that match it. A real profile lives only in %LOCALAPPDATA%\\claude-workspace\\profiles. See pipelines/app/README.md.",
  "privacy": {
    "hubPublic": true,
    "_markers": "Regexes for private names. Written so the pattern text itself does not match, because this file is tracked.",
    "markers": ["\\bexample[-_]internal[-_]name\\b"],
    "knownExposed": []
  },
  "node": { "pin": "20.15.1", "pinFile": ".nvmrc" },
  "git": { "integrationBranch": "main", "remote": "origin", "branchPrefix": "app/", "archivePrefix": "archive/app/" },
  "docs": {
    "readFirst": ["CLAUDE.md", "AGENTS.md", "docs/definition-of-done.md"],
    "reviewRules": "AGENTS.md, section Review rules",
    "refactorPrompts": "docs/prompts/",
    "recordsDir": "docs/records",
    "recordsIndex": "docs/README.md",
    "recordNameRe": "^[A-Z0-9][A-Z0-9_-]{2,60}\\.md$"
  },
  "isolation": {
    "mode": "worktree",
    "worktreePath": "C:\\dev\\example-run",
    "lockfile": "package-lock.json",
    "schemaFiles": ["apps/api/schema.sql"],
    "setup": ["install", "generate"],
    "refresh": { "onLockfile": ["install", "generate"], "onSchema": ["generate"] }
  },
  "ports": { "dev": [5173, 8080], "localServices": [5432, 6379], "closed": { "host": "127.0.0.1", "port": 1 } },
  "mainCheckoutGuard": {
    "label": "Example env guard",
    "file": "apps/api/src/env.mjs",
    "pattern": "EXAMPLE_TEST_MODE",
    "message": "Checks would load your real .env. Add the env guard first, or set up the run worktree."
  },
  "env": {
    "preset": {
      "EXAMPLE_TEST_MODE": "true",
      "EXAMPLE_DB_URL": "postgresql://test:test@127.0.0.1:1/example_test",
      "EXAMPLE_PAYMENT_KEY": "example-test-key",
      "EXAMPLE_CACHE_HOST": "127.0.0.1",
      "EXAMPLE_CACHE_PORT": "1",
      "EXAMPLE_QUEUE_URL": "redis://127.0.0.1:1/15"
    },
    "heapMb": 4096,
    "neverSet": ["EXAMPLE_IT_DB_URL"]
  },
  "workspaces": [
    { "id": "root", "dir": ".", "label": "root", "test": ["test:root"] },
    { "id": "api", "dir": "apps/api", "label": "API", "types": ["types:api"], "test": ["test:api"],
      "affectedBy": ["apps/api/", "packages/shared/"] },
    { "id": "web", "dir": "apps/web", "label": "Web", "types": ["types:web"], "lint": ["lint:web"], "test": ["test:web"],
      "affectedBy": ["apps/web/", "packages/shared/", "apps/api/src/routes/"] }
  ],
  "commands": {
    "test:root": { "kind": "test", "workspace": "root", "cwd": ".", "argv": ["{node}", "--test", "--test-reporter=tap", "{files}"], "files": { "list": ["scripts/tool.test.mjs"] }, "timeoutSec": 60 },
    "test:api": { "kind": "test", "workspace": "api", "cwd": "apps/api", "argv": ["{node}", "--test", "--test-reporter=tap", "{files}"], "files": { "roots": ["src"], "pattern": "\\.test\\.mjs$" }, "timeoutSec": 120 },
    "test:web": { "kind": "test", "workspace": "web", "cwd": "apps/web", "argv": ["{node}", "--test", "--test-reporter=tap", "{files}"], "files": { "roots": ["src"], "pattern": "\\.test\\.mjs$" }, "timeoutSec": 120 },
    "integration:api": { "kind": "test", "workspace": "api", "cwd": "apps/api", "argv": ["{node}", "--test", "--test-reporter=tap", "{files}"],
      "files": { "roots": ["src"], "pattern": "\\.integration\\.mjs$" }, "concurrency": 1, "timeoutSec": 300, "requiresPorts": [55001],
      "env": { "EXAMPLE_IT_DB_URL": "postgresql://test:test@127.0.0.1:55001/example_it" } },
    "types:api": { "kind": "types", "workspace": "api", "cwd": "apps/api", "argv": ["{node}", "-e", "process.exit(0)"], "heapMb": 4096, "timeoutSec": 120 },
    "types:web": { "kind": "types", "workspace": "web", "cwd": "apps/web", "argv": ["{node}", "-e", "process.exit(0)"], "timeoutSec": 120 },
    "lint:web": { "kind": "lint", "workspace": "web", "cwd": "apps/web", "argv": ["{node}", "-e", "console.log(JSON.stringify([]))", "{files}"], "files": { "roots": ["src"], "pattern": "\\.mjs$" }, "timeoutSec": 120 },
    "format:changed": { "kind": "format", "workspace": "root", "cwd": ".", "argv": ["{node}", "-e", "process.exit(0)", "{files}"], "timeoutSec": 60 },
    "generate": { "kind": "generate", "workspace": "api", "cwd": "apps/api", "argv": ["{node}", "-e", "process.exit(0)"], "onlyTree": "run", "timeoutSec": 60 },
    "install": { "kind": "install", "workspace": "root", "cwd": ".", "argv": ["{node}", "-e", "process.exit(0)"], "onlyTree": "run", "timeoutSec": 300 }
  },
  "format": { "cmd": "format:changed", "glob": "*.{mjs,md}" },
  "groups": {
    "G1": { "label": "Types", "perWorkspace": "types" },
    "G2": { "label": "Lint and unit tests", "perWorkspace": ["lint", "test"], "serverFocused": "api" },
    "G3": { "label": "API tests", "commands": ["test:api"], "when": ["apps/api/", "packages/shared/"] },
    "G4": { "label": "Integration", "commands": ["integration:api"], "when": ["apps/api/"], "requiresPorts": [55001] }
  },
  "levels": {
    "quick": { "groups": ["G0", "G1", "G2"] },
    "standard": { "groups": ["G0", "G1", "G2", "G3"] },
    "paranoid": { "groups": ["G0", "G1", "G2", "G3", "G4"], "verify": true }
  },
  "risk": {
    "money": ["apps/api/src/billing/**"],
    "tenant": ["apps/api/src/auth/**"],
    "contract": ["apps/api/src/routes/**/router.mjs", "apps/api/src/queues.mjs"]
  },
  "fences": {
    "forbidden": ["vendor/**", "**/generated.json", "**/.env", "**/.env.*", "**/.npmrc", "**/.sentryclirc", ".claude/**", "**/.claude/**"],
    "forbiddenExisting": ["apps/api/migrations/**"],
    "mustTick": ["**/package.json", "package-lock.json", "**/tsconfig*.json", "**/*.config.*", ".husky/**", ".github/**", ".nvmrc", "apps/api/src/auth/**", "apps/api/schema.sql"],
    "mustTickNew": ["apps/api/migrations/**"],
    "alwaysAllowed": ["docs/records/*.md", "docs/README.md"],
    "pinned": ["**/*.contract.test.mjs"],
    "testPattern": "\\.(test|integration)\\.mjs$"
  },
  "secrets": { "trackedSecretFiles": [], "denyReadGlobs": ["**/.env", "**/.env.*", "**/.npmrc", "**/.sentryclirc"], "allowValues": ["example-test-key"] },
  "builders": { "memberProcedure": "shop", "staffProcedure": "shop", "signedInProcedure": "protected", "openProcedure": "public" },
  "assertingBuilders": ["staffProcedure"],
  "assertPattern": "\\b(?:ensure|check)[A-Z]\\w*\\s*\\(",
  "contract": {
    "routerFiles": ["apps/api/src/routes/**/router.mjs"],
    "legacyRouter": "apps/api/src/legacy/router.mjs",
    "queues": [ { "file": "apps/api/src/queues.mjs", "regex": "QUEUE_NAME\\s*=\\s*['\"]([^'\"]+)['\"]" } ]
  },
  "probes": [
    { "id": "procedures", "kind": "routerKeys", "label": "Procedures by guard", "measures": "router keys per procedure builder", "files": ["apps/api/src/routes/**/router.mjs"] },
    { "id": "missingAssert", "kind": "missingAssert", "label": "Member procedures with no ensure check", "measures": "member router keys whose body has no ensure or check call", "files": ["apps/api/src/routes/**/router.mjs"] },
    { "id": "todoCount", "kind": "regexCount", "label": "TODO comments", "measures": "TODO comments in api source, tests excluded", "files": ["apps/api/src/**/*.mjs"], "exclude": ["**/*.test.mjs"], "regex": "\\bTODO\\b" },
    { "id": "publicTs", "kind": "publicTs", "label": "public.mjs boundaries", "measures": "web features with a public entry", "featuresDir": "apps/web/src/features", "boundaryTestRegex": "Boundary\\.test\\.mjs$" },
    { "id": "deepImports", "kind": "deepImports", "label": "Web deep imports", "measures": "imports from one web feature into another feature's internals", "featuresDir": "apps/web/src/features", "alias": "@/features/", "publicEntries": ["public", "public.mjs", "index"] },
    { "id": "localeWeb", "kind": "localeParity", "label": "Missing web i18n keys", "measures": "keys missing per locale against en", "dir": "apps/web/messages", "source": "en" }
  ],
  "tiles": ["knownFailures", "deepImports", "publicTs", "todoCount", "localeWeb"],
  "lenses": ["missingAssert", "todoCount"],
  "score": {
    "knownFailures": { "weight": 2, "target": 0, "ref": 20 },
    "deepImports": { "weight": 2, "target": 0, "ref": 50 },
    "publicTs": { "weight": 1, "target": 4, "ref": 0, "higherIsBetter": true },
    "todoCount": { "weight": 1, "target": 0, "ref": 30 }
  },
  "achievements": [
    { "id": "baseline-zero", "label": "Baseline zero", "when": { "metric": "knownFailures", "op": "<=", "value": 0 } },
    { "id": "boundary-builder", "label": "Boundary builder", "when": { "metric": "publicTs", "op": ">=", "value": 2 } },
    { "id": "phase1-cleared", "label": "Phase 1 cleared", "when": { "phaseClosed": "1" } }
  ],
  "fun": { "bossPhase": "1" },
  "findings": {
    "audit": "C:\\example\\reports\\audit.md",
    "idPattern": "\\bEX-\\d{1,3}\\b"
  },
  "runTg": [
    { "id": "dev-web", "label": "Web dev server", "cwd": ".", "argv": ["{node}", "{npmCli}", "run", "dev"], "warn": "Starts the dev server with your real settings." }
  ]
}
